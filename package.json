{
  "name": "@homebound/graphql-typescript-possible-types",
  "version": "2.0.0-bump",
  "main": "./build/index.js",
  "types": "./build/",
  "scripts": {
    "build": "rm -rf build; tsc --project tsconfig.build.json",
    "test": "jest",
    "coverage": "jest --collectCoverage",
    "format": "prettier --write 'src/**/*.{ts,js,tsx,jsx}'",
    "postinstall": "husky",
    "prepack": "pinst --disable && yarn build",
    "postpack": "pinst --enable"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^6.0.0",
    "change-case": "^4.1.2",
    "ts-poet": "^6.12.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.0",
    "@types/jest": "^30.0.0",
    "graphql": "^16.11.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.3",
    "memfs": "^4.49.0",
    "pinst": "^3.0.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.18.1",
  "lint-staged": {
    "*.{ts,js,tsx,jsx,graphql}": "prettier --write"
  }
}
